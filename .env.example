# 本机 Docker Compose 用这份模板。复制为 .env 后改密码和密钥。
# 服务器部署不要用这里的默认数据库密码，按 README 里「服务器 Docker Compose」现场生成。

# 面板登录密码。第一次启动写入库。
PANEL_PASSWORD=change-me

# 本机 http://127.0.0.1 保持 false。前面如果加了 HTTPS 再改 true。
PANEL_COOKIE_SECURE=false

# 加密 AccessKey / yyds 密码 / cookie，至少 16 位。部署后不要换。
SECRET_KEY=change-this-to-a-long-random-string

# 本机 compose 的数据库服务名是 db，用户名/库名/密码都是 domainslot。
DATABASE_URL=postgresql+psycopg://domainslot:domainslot@db:5432/domainslot

YYDS_API_BASE=https://maliapi.215.im/v1
YYDS_POLL_SECONDS=20
ALIYUN_POLL_SECONDS=60
VERIFY_ATTEMPTS=12
VERIFY_RETRY_SECONDS=15
TZ=Asia/Shanghai
LISTEN_HOST=0.0.0.0
LISTEN_PORT=8788
